# OpenAI / LLM Configuration (cho bước dịch thuật EN -> VI)
OPENAI_API_KEY=
OPENAI_BASE_URL=
TRANSLATION_MODEL=gpt-4o-mini

# TTS Configuration (cho bước chuyển văn bản tiếng Việt sang Audio)
# Lựa chọn provider: "edge-tts" (miễn phí, giọng đọc tiếng Việt rất tự nhiên) hoặc "openai"
TTS_PROVIDER=piper

# Giọng đọc cho Edge-TTS:
# - vi-VN-HoaiMyNeural (Nữ - truyền cảm, đọc tiểu thuyết rất hay)
# - vi-VN-NamMinhNeural (Nam - trầm ấm, lịch sử kiếm hiệp)
TTS_VOICE=vi-VN-HoaiMyNeural

# Tốc độ đọc (e.g. "+0%", "+10%", "-5%")
TTS_RATE=+0%

# Cấu hình phân đoạn văn bản và chạy song song
MAX_CHUNK_CHARS=2000
TTS_CONCURRENCY=3
PIPER_MODEL_PATH  = "models/piper/vi_VN-vais1000-medium.onnx"
PIPER_CONFIG_PATH = "models/piper/vi_VN-vais1000-medium.onnx.json"
PIPER_NUM_WORKERS = 4
# ===== VieNeu-TTS =====
# Mode: "v3turbo" (khuyên dùng, nhanh + nhẹ), "standard", "fast", "remote"
VIENEU_MODE=v3turbo
# Giọng đọc: để trống dùng giọng mặc định; ví dụ "Minh Quân", "Ngọc Lan"
VIENEU_VOICE=
# Backbone (chỉ cần khi dùng mode standard/fast)
VIENEU_BACKBONE_REPO=
VIENEU_BACKBONE_DEVICE=cpu
VIENEU_PRECISION=
# Codec
VIENEU_CODEC_REPO=
VIENEU_CODEC_DEVICE=cpu
# Remote mode (chỉ cần khi VIENEU_MODE=remote)
VIENEU_API_BASE=
VIENEU_MODEL_NAME=

# HuggingFace token (nếu model yêu cầu đăng nhập)
HF_TOKEN=
# Translation backend: openai (default) or deepseek (native infra client)
TRANSLATION_PROVIDER=openai
DEEPSEEK_MODEL=deepseek-chat

# Maximum text chunks in one DeepSeek conversation (>= 1)
DEEPSEEK_MAX_CHUNKS_PER_CONVERSATION=5

# Automatic glossary learning. Set false to translate without extraction calls.
GLOSSARY_AUTO_UPDATE=true
GLOSSARY_MIN_OCCURRENCES=3
GLOSSARY_MIN_DISTINCT_CHUNKS=2
GLOSSARY_MAX_AUTO_ENTRIES=500
GLOSSARY_MAX_PROMPT_ENTRIES=100
GLOSSARY_MAX_CANDIDATES=2000

# Number of chapters per video (>= 1). Chapter TXT files remain separate.
VIDEO_CHAPTERS_PER_VIDEO=1

# Static-background video encoding
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
# Optional TTF/OTF font for Vietnamese titles
VIDEO_FONT_PATH=

# YouTube: enable YouTube Data API v3 and create OAuth Desktop app credentials.
YOUTUBE_CLIENT_SECRETS_FILE=.secrets/youtube/client_secret.json
YOUTUBE_TOKEN_FILE=.secrets/youtube/token.json
YOUTUBE_CHANNEL_ID=
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=22
# Optional: keep this directory to preserve upload resume/deduplication state.
# YOUTUBE_STATE_DIR=output/.state/youtube

# Maximum translated characters per separate episode metadata request.
METADATA_MAX_INPUT_CHARS=60000
